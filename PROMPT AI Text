# BAGIAN 1: FUNGSI ELIMINASI GAUSS
# Fungsi ini digunakan untuk menyelesaikan tiga
# persamaan linear dengan metode Eliminasi Gauss.

def eliminasi_gauss(matriks):

    # Menentukan jumlah variabel, yaitu x, y, dan z
    n = 3

    # Menyalin matriks agar data asli tidak berubah
    A = [baris[:] for baris in matriks]


    # BAGIAN 2: PROSES ELIMINASI GAUSS
    # Mengubah matriks menjadi bentuk segitiga atas.

    for i in range(n):

        # Memeriksa apakah elemen diagonal bernilai nol
        # Jika nol, program mencari baris lain untuk ditukar.
        if abs(A[i][i]) < 1e-12:

            baris_pengganti = None

            for k in range(i + 1, n):
                if abs(A[k][i]) >= 1e-12:
                    baris_pengganti = k
                    break

            # Jika tidak ditemukan baris pengganti,
            # sistem tidak memiliki solusi tunggal.
            if baris_pengganti is None:
                raise ValueError(
                    "Sistem tidak memiliki solusi tunggal."
                )

            # Menukar baris agar proses eliminasi dapat dilanjutkan
            A[i], A[baris_pengganti] = A[baris_pengganti], A[i]

        # Menghilangkan variabel pada baris di bawah pivot
        for j in range(i + 1, n):

            # Menghitung faktor eliminasi
            faktor = A[j][i] / A[i][i]

            # Mengubah nilai setiap kolom pada baris
            for k in range(i, n + 1):
                A[j][k] = A[j][k] - faktor * A[i][k]


    # BAGIAN 3: SUBSTITUSI MUNDUR
    # Menghitung nilai variabel dari bawah ke atas,
    # dimulai dari z, kemudian y, dan terakhir x.

    # Menyiapkan tempat untuk menyimpan hasil x, y, dan z
    hasil = [0.0, 0.0, 0.0]

    # Menghitung variabel dari baris terakhir ke baris pertama
    for i in range(n - 1, -1, -1):

        # Menghitung jumlah perkalian variabel yang sudah diketahui
        jumlah = sum(
            A[i][j] * hasil[j]
            for j in range(i + 1, n)
        )

        # Memeriksa apakah elemen diagonal bernilai nol
        if abs(A[i][i]) < 1e-12:
            raise ValueError(
                "Sistem tidak memiliki solusi tunggal."
            )

        # Menghitung nilai variabel
        hasil[i] = (A[i][n] - jumlah) / A[i][i]

    # Mengembalikan hasil perhitungan dan matriks akhir
    return hasil, A


